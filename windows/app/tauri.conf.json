{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpaceSaver",
  "version": "0.1.0",
  "identifier": "com.spacesaver.windows",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SpaceSaver",
        "width": 1180,
        "height": 760,
        "minWidth": 920,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "SpaceSaver",
    "copyright": "MIT licence",
    "category": "Utility",
    "shortDescription": "Disk cleaner for developers",
    "longDescription": "SpaceSaver finds regenerable developer junk (node_modules in dormant projects, build caches, package-manager caches, AI models) and moves it to the Recycle Bin with undo.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  }
}
